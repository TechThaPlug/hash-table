<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | File Uploader</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <nav>
      <a class="brand" href="/">File Uploader</a>
      <% if (currentUser) { %>
        <a href="/folders">My folders</a>
        <span class="who"><%= currentUser.username %></span>
        <form method="POST" action="/log-out" class="inline">
          <button type="submit" class="link-button">Log out</button>
        </form>
      <% } else { %>
        <a href="/log-in">Log in</a>
        <a href="/sign-up">Sign up</a>
      <% } %>
    </nav>
  </header>
  <main>
    <% if (flash) { %>
      <div class="flash <%= flash.type %>" role="status"><%= flash.text %></div>
    <% } %>